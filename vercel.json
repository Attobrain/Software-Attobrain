{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/", "destination": "/live.html" },
    { "source": "/profissional", "destination": "/live.html" },
    { "source": "/aluno", "destination": "/live.html" }
  ],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; connect-src 'self' https: wss:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" }
    ]
  }]
}
