{
  "name": "attobrain",
  "version": "1.0.0",
  "private": true,
  "description": "Protótipo demonstrativo do Attobrain em Node.js",
  "main": "index.js",
  "scripts": {
    "build:web": "node scripts/build-web.js",
    "build:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-launcher.ps1",
    "start": "node index.js",
    "start:xampp": "node --env-file=.env index.js",
    "test": "node --test engine.test.js realtime.test.js src/tests/*.test.js",
    "test:soak": "node scripts/soak.js",
    "mazes:verify": "node scripts/select-mazes.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "fft.js": "^4.0.4",
    "mysql2": "^3.24.6",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
