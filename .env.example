# Configurar no painel da Vercel (valor público, incluído no frontend):
ATTOBRAIN_SERVER_URL=https://seu-servidor-node.exemplo.com

# Configurar no serviço Node (origens exatas separadas por vírgula, sem barra final):
ALLOWED_ORIGINS=https://seu-projeto.vercel.app
PORT=3000

# O desenvolvimento local não exige estas variáveis.
# npm start não carrega .env automaticamente: use o painel da hospedagem ou o ambiente do terminal.
